# ---- Supabase (copy to .env.local and fill in; also set these in Vercel) ----

# Project URL — Supabase → Settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon public key — Supabase → Settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key — server-only. NEVER prefix with NEXT_PUBLIC and never ship
# to the browser. Used by Route Handlers / Server Actions (e.g. order writes).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
